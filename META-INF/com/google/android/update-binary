#!/sbin/sh
# Magisk module installer (self-contained; does not source util_functions)

UNZIP=$(command -v unzip || echo /system/bin/unzip)

ui_print() { echo " - $*"; }
abort() { ui_print "$*"; exit 1; }

ui_print "Termux Root SU v3.9"
[ -z "$MODPATH" ] && MODPATH=/data/adb/modules/termux-root-su
[ -z "$ZIPFILE" ] && abort "ZIPFILE not set"

# Clean previous contents (keep the dir itself so Magisk state survives)
mkdir -p "$MODPATH" || abort "cannot mkdir $MODPATH"
find "$MODPATH" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null

ui_print "Extracting to $MODPATH"
"$UNZIP" -o -q "$ZIPFILE" -d "$MODPATH" 1>&2 || abort "extraction failed"
rm -rf "$MODPATH/META-INF"

ui_print "Setting permissions"
chmod 0755 "$MODPATH" 2>/dev/null
for f in module.prop bashrc-snippet.sh DEBUG_NOTES.md DEV_NOTES.md CHANGELOG.md; do
    [ -f "$MODPATH/$f" ] && chmod 0644 "$MODPATH/$f"
done
for x in magisk-proxy su service.sh boot-completed.sh; do
    [ -f "$MODPATH/$x" ] && chmod 0755 "$MODPATH/$x"
done

rm -f "$MODPATH/disable" "$MODPATH/remove"

ui_print "Installed. Reboot, or run now:"
ui_print "  sh $MODPATH/service.sh"
